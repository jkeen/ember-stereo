<DocsHeader as |header|>
  <header.link @route='diagnostic'>
    Diagnostic
  </header.link>
  <Docs::ThemeToggle />
</DocsHeader>
<DocsViewer as |viewer|>
  <viewer.nav as |nav|>
    <nav.section @label='Overview' />
    <nav.item @label='Intro' @route='docs.index' />
    <nav.item @label='Upgrading' @route='docs.upgrading' />
    <nav.section @label='Usage' />
    <nav.item @label='Playing Sounds' @route='docs.playing-sounds' />
    <nav.item @label='Custom Metadata' @route='docs.metadata' />
    <nav.item @label='Monitoring Events' @route='docs.event-monitoring' />
    <nav.item @label='AirPlay & Chromecast' @route='docs.casting' />
    <nav.item @label='Advanced' @route='docs.advanced' />
    <nav.section @label='Gotchas' />
    <nav.item @label='Browser Audio' @route='docs.browser-audio' />
    <nav.section @label='Development' />
    <nav.item @label='Testing' @route='docs.testing' />
    <nav.item @label='Debugging' @route='docs.debugging' />
  </viewer.nav>

  <viewer.main>
    <div class='docs-container'>
      <div class='docs-section'>
        {{outlet}}
      </div>
    </div>
  </viewer.main>
</DocsViewer>