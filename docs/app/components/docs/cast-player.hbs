<div {{did-insert this.prepare}} {{will-destroy this.teardown}}>
  <DocsDemo as |demo|>

    <demo.example @name='cast-player.hbs'>
      <Docs::CastSupport />

      {{! BEGIN-SNIPPET cast-player.hbs }}
      <div class='flex flex-wrap gap-2 mt-4'>
        <button type='button' class='ui-button' {{cast-button}}>
          {{#if (is-casting)}}
            Casting to
            {{this.deviceLabel}}
          {{else if (casting-available)}}
            Cast
          {{else}}
            No cast targets available
          {{/if}}
        </button>

        <button
          type='button'
          class='ui-button'
          {{on 'click' this.setNowPlaying}}
        >
          Set now playing
        </button>

        {{#if (is-casting)}}
          <button
            type='button'
            class='ui-button'
            {{on 'click' this.stopCasting}}
          >
            Stop casting
          </button>
        {{/if}}
      </div>
      {{! END-SNIPPET }}

      <dl class='grid grid-cols-2 gap-x-4 gap-y-1 mt-4 text-sm max-w-md'>
        <dt class='font-semibold'><code>isCastingAvailable</code></dt>
        <dd>{{if this.stereo.isCastingAvailable 'true' 'false'}}</dd>

        <dt class='font-semibold'><code>supportedCastType</code></dt>
        <dd>{{or this.stereo.supportedCastType '—'}}</dd>

        <dt class='font-semibold'><code>isCasting</code></dt>
        <dd>{{if this.stereo.isCasting 'true' 'false'}}</dd>

        <dt class='font-semibold'><code>castKind</code></dt>
        <dd>{{or this.stereo.castKind '—'}}</dd>

        <dt class='font-semibold'><code>castDeviceName</code></dt>
        <dd>{{or this.stereo.castDeviceName '—'}}</dd>

        <dt class='font-semibold'><code>sound.metadata.title</code></dt>
        <dd>{{this.nowPlaying}}</dd>
      </dl>

      <ul class='mt-4 text-sm'>
        {{#each this.log as |entry|}}
          <li>
            <span class='font-mono'>{{entry.name}}</span>
            &rarr;
            {{entry.device}}
          </li>
        {{else}}
          <li class='opacity-60'>No cast events yet.</li>
        {{/each}}
      </ul>
    </demo.example>
    <demo.snippet @name='cast-player.hbs' />
    <demo.snippet @name='cast-player.js' />
  </DocsDemo>
</div>